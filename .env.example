# Optional — only needed if you want Adzuna as a job source.
# Remotive and Arbeitnow work with no keys at all.
#
# Sign up for a free Adzuna account (250 calls/month) at:
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Adzuna country code for search results, e.g. gb, us, in, ca, au, de, fr
ADZUNA_COUNTRY=gb

# --- Used by daily_job_check.py (the cron / overnight search script) ---
# Comma-separated search terms to check automatically.
SEARCH_QUERIES=backend developer,python engineer

# Optional location filter (used by Adzuna only)
SEARCH_LOCATION=

# Max results fetched per source per query, default 15
SEARCH_LIMIT_PER_SOURCE=15
